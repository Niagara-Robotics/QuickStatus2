<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/qss">
    <file>stylesheet.qss</file>
  </qresource>
  <qresource prefix="/fonts">
    <file alias="B612-Bold">fonts/B612-Bold.ttf</file>
    <file alias="B612Mono-Bold">fonts/B612Mono-Bold.ttf</file>
    <file alias="B612-Regular">fonts/B612-Regular.ttf</file>
    <file alias="B612Mono-Regular">fonts/B612Mono-Regular.ttf</file>
  </qresource>
  <qresource prefix="/images/dock">
    <file alias="close">images/dock/close.png</file>
    <file alias="float">images/dock/float.png</file>
    <file alias="blank">images/dock/blank.png</file>
  </qresource>
  <qresource prefix="/images/auto">
    <file alias="edit">images/auto/edit.png</file>
    <file alias="check">images/auto/check.png</file>
    <file alias="unchecked">images/auto/unchecked.png</file>
    <file alias="edit_hover">images/auto/edit_hover.png</file>
    <file alias="edit_press">images/auto/edit_press.png</file>
  </qresource>
  <qresource prefix="/images/swerve">
    <file alias="wheel">images/swerve/swerve_wheel.svg</file>
    <file alias="velocity">images/swerve/swerve_velocity.svg</file>
    <file alias="power">images/swerve/swerve_power.svg</file>
    <file alias="base">images/swerve/swerve_base.svg</file>
  </qresource>
  <qresource prefix="/images/shooter">
    <file alias="outline">images/shooter/outline.svg</file>
    <file alias="wheel_10">images/shooter/wheel_10.svg</file>
    <file alias="wheel_8">images/shooter/wheel_8.svg</file>
  </qresource>
  <qresource prefix="/">
    <file>icon.ico</file>
  </qresource>
  <qresource prefix="/images/status_bar">
    <file alias="swerve">images/status_bar/swerve.png</file>
    <file alias="shift">images/status_bar/shift.png</file>
    <file alias="auto">images/status_bar/auto.png</file>
    <file alias="spacer">images/status_bar/spacer.png</file>
    <file alias="vision">images/status_bar/vision.png</file>
    <file alias="divider">images/status_bar/divider.png</file>
    <file alias="shooter">images/status_bar/shooter.png</file>
    <file alias="control_mode">images/status_bar/control_mode.png</file>
  </qresource>
  <qresource prefix="/images/status_bar/disabled">
    <file alias="vision">images/status_bar/disabled/vision.png</file>
    <file alias="shift">images/status_bar/disabled/shift.png</file>
    <file alias="control_mode">images/status_bar/disabled/control_mode.png</file>
    <file alias="swerve">images/status_bar/disabled/swerve.png</file>
    <file alias="auto">images/status_bar/disabled/auto.png</file>
    <file alias="shooter">images/status_bar/disabled/shooter.png</file>
    <file alias="spacer">images/status_bar/disabled/spacer.png</file>
  </qresource>
</RCC>
